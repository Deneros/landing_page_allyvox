# VoxAlly Landing Page - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SITE CONFIGURATION
# ===========================================

# Base URL for the site (used for SEO, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===========================================
# ANALYTICS (Optional)
# ===========================================

# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# CONTACT FORM (Optional)
# ===========================================

# Email service API key (e.g., SendGrid, Resend)
# CONTACT_FORM_API_KEY=your-api-key

# Email address to receive contact form submissions
# CONTACT_FORM_TO_EMAIL=contact@your-domain.com

# ===========================================
# CMS / CONTENT (Optional)
# ===========================================

# If using a headless CMS for content management
# CMS_API_URL=https://api.your-cms.com
# CMS_API_KEY=your-cms-api-key

# ===========================================
# IMAGE HOSTING (Optional)
# ===========================================

# If using a CDN for images
# NEXT_PUBLIC_IMAGE_CDN_URL=https://cdn.your-domain.com
